{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e:m7": "playwright test -c playwright.m7.config.ts tests/e2e/m7-walkthrough.spec.ts",
    "test:e2e:m8": "playwright test -c playwright.m7.config.ts tests/e2e/m8-level-selection.spec.ts",
    "test:e2e:m10": "playwright test -c playwright.m10.config.ts tests/e2e/m10-ux-walkthrough.spec.ts",
    "test:e2e:m11": "playwright test -c playwright.m11.config.ts tests/e2e/m11-localization-mobile.spec.ts",
    "test:e2e:m11-real": "playwright test -c playwright.m11-real.config.ts tests/e2e/m11-real-backend-state.spec.ts"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
