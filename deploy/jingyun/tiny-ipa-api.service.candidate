# CANDIDATE - DO NOT APPLY.
# Repository-only systemd unit candidate for Tiny IPA on ipa.jingyun.bj.cn.
# This file must not be copied to /etc/systemd/system/ without a later
# Human-authorized host action. The service user, group, and env file are
# intentionally unresolved Human-owned placeholders.

[Unit]
Description=Tiny IPA backend API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=<HUMAN_APPROVED_TINY_IPA_SERVICE_USER>
Group=<HUMAN_APPROVED_TINY_IPA_SERVICE_GROUP>
WorkingDirectory=/opt/tiny-ipa/current/backend
EnvironmentFile=<HUMAN_OWNED_TINY_IPA_ENV_FILE>
ExecStart=/opt/tiny-ipa/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 18110
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tiny-ipa
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
