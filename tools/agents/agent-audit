#!/usr/bin/env bash
set -euo pipefail

limit="${AGENT_AUDIT_LIMIT:-100}"
comments_limit="${AGENT_COMMENTS_LIMIT:-100}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
gh_retry="$root/tools/agents/gh-retry"
source "$root/tools/agents/_lib.sh"
repo="$(agent_repo)"

usage() {
  cat <<'USAGE'
Usage:
  tools/agents/agent-audit

Runs a read-only consistency audit for the label/comment based agent workflow.
This intentionally avoids GitHub Project v2 so it stays fast and robust.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -gt 0 ]]; then
  usage
  exit 0
fi

next_labels=()
while IFS= read -r label; do
  next_labels+=("$label")
done < <(agent_primary_next_labels)
issues_json="$("$gh_retry" gh api -X GET "$(repo_api_path "$repo")/issues" \
  -f state=open \
  -f per_page="$limit")"
closed_issues_json="$("$gh_retry" gh api -X GET "$(repo_api_path "$repo")/issues" \
  -f state=closed \
  -f per_page="$limit")"
prs_json="$("$gh_retry" gh api -X GET "$(repo_api_path "$repo")/pulls" \
  -f state=open \
  -f per_page="$limit")"

labels_for_issue() {
  jq -r '[.labels[].name] | join("\n")' <<< "$1"
}

issue_comments_text() {
  local issue="$1"

  "$gh_retry" gh api -X GET "$(repo_api_path "$repo")/issues/$issue/comments" \
    -f per_page="$comments_limit" \
    --jq '[.[].body] | join("\n")'
}

has_any_next_label() {
  local labels="$1"
  local label

  for label in "${next_labels[@]}"; do
    if grep -Fxq "$label" <<< "$labels"; then
      return 0
    fi
  done

  return 1
}

pickup_is_active() {
  awk '
    /Pickup confirmed/ {
      active = 1
    }
    /completion handoff|Completion handoff|handoff complete|Handoff complete|Routing: moved this issue back|Architect sync after PR merge/ {
      active = 0
    }
    END {
      exit active ? 0 : 1
    }
  ' <<< "$1"
}

matched_next_labels() {
  local labels="$1"
  local matched=()
  local label

  for label in "${next_labels[@]}"; do
    if grep -Fxq "$label" <<< "$labels"; then
      matched+=("$label")
    fi
  done

  if (( ${#matched[@]} > 0 )); then
    printf '%s\n' "${matched[@]}"
  fi
}

contract_handoff_value() {
  local contract="$1"
  local line

  line="$(extract_contract_line "Completion handoff:" "$contract")"
  if [[ "$line" == "Completion handoff: MISSING" ]]; then
    printf 'MISSING\n'
    return
  fi

  sed -E 's/^Completion handoff:[[:space:]]*//' <<< "$line"
}

handoff_state() {
  local value="$1"
  local role

  case "$value" in
    MISSING)
      printf 'missing'
      ;;
    "batch checkpoint"|"close after evidence"|hold|none)
      printf 'ok'
      ;;
    to:*)
      role="${value#to:}"
      if agent_role_exists "$role"; then
        printf 'ok'
      else
        printf 'unknown role'
      fi
      ;;
    *)
      printf 'unknown value'
      ;;
  esac
}

printf '== Agent Workflow Audit ==\n'

printf '\n== Open issues with multiple next-action labels ==\n'
multi_count=0
while IFS= read -r issue_json; do
  [[ -z "$issue_json" ]] && continue
  labels="$(labels_for_issue "$issue_json")"
  matched=()
  while IFS= read -r label; do
    [[ -z "$label" ]] && continue
    matched+=("$label")
  done < <(matched_next_labels "$labels")
  if (( ${#matched[@]} > 1 )); then
    multi_count=$((multi_count + 1))
    printf '#%s %s\n  labels: %s\n  %s\n' \
      "$(jq -r '.number' <<< "$issue_json")" \
      "$(jq -r '.title' <<< "$issue_json")" \
      "$(IFS=,; echo "${matched[*]}")" \
      "$(jq -r '.html_url' <<< "$issue_json")"
  fi
done < <(jq -c '.[] | select(has("pull_request") | not)' <<< "$issues_json")
if [[ "$multi_count" -eq 0 ]]; then
  printf 'none\n'
fi

printf '\n== Open issues with unknown needs labels ==\n'
unknown_count=0
while IFS= read -r issue_json; do
  [[ -z "$issue_json" ]] && continue
  labels="$(labels_for_issue "$issue_json")"
  unknown=()
  while IFS= read -r label; do
    [[ -z "$label" ]] && continue
    if [[ "$label" == needs:* ]] && ! agent_is_primary_next_label "$label"; then
      unknown+=("$label")
    fi
  done <<< "$labels"
  if (( ${#unknown[@]} > 0 )); then
    unknown_count=$((unknown_count + 1))
    printf '#%s %s\n  unknown: %s\n  %s\n' \
      "$(jq -r '.number' <<< "$issue_json")" \
      "$(jq -r '.title' <<< "$issue_json")" \
      "$(IFS=,; echo "${unknown[*]}")" \
      "$(jq -r '.html_url' <<< "$issue_json")"
  fi
done < <(jq -c '.[] | select(has("pull_request") | not)' <<< "$issues_json")
if [[ "$unknown_count" -eq 0 ]]; then
  printf 'none\n'
fi

printf '\n== Open task issues without next-action labels ==\n'
unrouted_count=0
while IFS= read -r issue_json; do
  [[ -z "$issue_json" ]] && continue
  labels="$(labels_for_issue "$issue_json")"
  if ! has_any_next_label "$labels" && grep -Fxq "type:task" <<< "$labels"; then
    issue="$(jq -r '.number' <<< "$issue_json")"
    body="$(jq -r '.body // ""' <<< "$issue_json")"
    comments="$(issue_comments_text "$issue")"
    contract="$(extract_latest_contract_block "$body"$'\n'"$comments")"
    if pickup_is_active "$comments"; then
      continue
    elif [[ "$(contract_handoff_value "$contract")" == "batch checkpoint" ]]; then
      continue
    else
      state_hint="unrouted"
    fi
    unrouted_count=$((unrouted_count + 1))
    printf '#%s %s\n  state hint: %s\n  %s\n' \
      "$issue" \
      "$(jq -r '.title' <<< "$issue_json")" \
      "$state_hint" \
      "$(jq -r '.html_url' <<< "$issue_json")"
  fi
done < <(jq -c '.[] | select(has("pull_request") | not)' <<< "$issues_json")
if [[ "$unrouted_count" -eq 0 ]]; then
  printf 'none\n'
fi

printf '\n== Closed issues still carrying next-action labels ==\n'
closed_count=0
while IFS= read -r issue_json; do
  [[ -z "$issue_json" ]] && continue
  labels="$(labels_for_issue "$issue_json")"
  while IFS= read -r label; do
    [[ -z "$label" ]] && continue
    closed_count=$((closed_count + 1))
    printf '#%s %s\n  label: %s\n  %s\n' \
      "$(jq -r '.number' <<< "$issue_json")" \
      "$(jq -r '.title' <<< "$issue_json")" \
      "$label" \
      "$(jq -r '.html_url' <<< "$issue_json")"
  done < <(matched_next_labels "$labels")
done < <(jq -c '.[] | select(has("pull_request") | not)' <<< "$closed_issues_json")
if [[ "$closed_count" -eq 0 ]]; then
  printf 'none\n'
fi

printf '\n== Pickup comments with stale next-action labels ==\n'
pickup_count=0
while IFS= read -r issue_json; do
  [[ -z "$issue_json" ]] && continue
  labels="$(labels_for_issue "$issue_json")"
  if has_any_next_label "$labels"; then
    issue="$(jq -r '.number' <<< "$issue_json")"
    comments="$(issue_comments_text "$issue")"
    if pickup_is_active "$comments"; then
      matched="$(matched_next_labels "$labels" | agent_join_lines)"
      pickup_count=$((pickup_count + 1))
      printf '#%s %s\n  stale labels: %s\n  %s\n' \
        "$issue" \
        "$(jq -r '.title' <<< "$issue_json")" \
        "$matched" \
        "$(jq -r '.html_url' <<< "$issue_json")"
    fi
  fi
done < <(jq -c '.[] | select(has("pull_request") | not)' <<< "$issues_json")
if [[ "$pickup_count" -eq 0 ]]; then
  printf 'none\n'
fi

printf '\n== Contract handoff route issues ==\n'
handoff_count=0
while IFS= read -r issue_json; do
  [[ -z "$issue_json" ]] && continue
  labels="$(labels_for_issue "$issue_json")"
  if ! grep -Fxq "type:task" <<< "$labels"; then
    continue
  fi
  issue="$(jq -r '.number' <<< "$issue_json")"
  title="$(jq -r '.title' <<< "$issue_json")"
  body="$(jq -r '.body // ""' <<< "$issue_json")"
  comments="$(issue_comments_text "$issue")"
  contract="$(extract_latest_contract_block "$body"$'\n'"$comments")"
  if [[ -z "$contract" ]]; then
    continue
  fi
  handoff="$(contract_handoff_value "$contract")"
  state="$(handoff_state "$handoff")"
  if [[ "$state" != "ok" ]]; then
    handoff_count=$((handoff_count + 1))
    printf '#%s %s\n  handoff: %s (%s)\n  contract: %s\n  %s\n' \
      "$issue" "$title" "$handoff" "$state" \
      "$(contract_header "$contract")" "$(jq -r '.html_url' <<< "$issue_json")"
  fi
done < <(jq -c '.[] | select(has("pull_request") | not)' <<< "$issues_json")
if [[ "$handoff_count" -eq 0 ]]; then
  printf 'none\n'
fi

printf '\n== needs:implementer contract gaps ==\n'
gap_count=0
while IFS= read -r issue_json; do
  [[ -z "$issue_json" ]] && continue
  issue="$(jq -r '.number' <<< "$issue_json")"
  title="$(jq -r '.title' <<< "$issue_json")"
  body="$(jq -r '.body // ""' <<< "$issue_json")"
  comments="$(issue_comments_text "$issue")"
  contract="$(extract_latest_contract_block "$body"$'\n'"$comments")"
  missing=()
  for prefix in "Branch strategy:" "Base branch:" "Target PR base:" "Depends on:" "Completion handoff:"; do
    line="$(extract_contract_line "$prefix" "$contract")"
    if [[ "$line" == "$prefix MISSING" ]]; then
      missing+=("$prefix")
    fi
  done
  if (( ${#missing[@]} > 0 )); then
    gap_count=$((gap_count + 1))
    printf '#%s %s\n  missing: %s\n  contract: %s\n  %s\n' \
      "$issue" "$title" "$(IFS=,; echo "${missing[*]}")" \
      "$(contract_header "$contract")" "$(jq -r '.html_url' <<< "$issue_json")"
  fi
done < <(jq -c '.[] |
  select(has("pull_request") | not) |
  select(any(.labels[].name; . == "needs:implementer"))' <<< "$issues_json")
if [[ "$gap_count" -eq 0 ]]; then
  printf 'none\n'
fi

printf '\n== Open PRs with suspicious base branch ==\n'
base_count=0
while IFS= read -r pr_json; do
  [[ -z "$pr_json" ]] && continue
  pr="$(jq -r '.number' <<< "$pr_json")"
  base="$(jq -r '.base.ref' <<< "$pr_json")"
  title="$(jq -r '.title' <<< "$pr_json")"
  body="$(jq -r '.body // ""' <<< "$pr_json")"
  issue="$(
    printf '%s\n%s\n' "$title" "$body" |
      sed -nE 's/.*#([0-9]+).*/\1/p' |
      head -n 1
  )"
  if [[ -z "$issue" ]]; then
    continue
  fi
  issue_json="$("$gh_retry" gh api "$(repo_api_path "$repo")/issues/$issue" 2>/dev/null || true)"
  if [[ -z "$issue_json" ]]; then
    continue
  fi
  issue_body="$(jq -r '.body // ""' <<< "$issue_json")"
  comments="$("$gh_retry" gh api -X GET "$(repo_api_path "$repo")/issues/$issue/comments" \
    -f per_page="$comments_limit" \
    --jq '[.[].body] | join("\n")')"
  contract="$(extract_latest_contract_block "$issue_body"$'\n'"$comments")"
  target_line="$(extract_contract_line "Target PR base:" "$contract")"
  target="$(sed -nE 's/^Target PR base: `?([^` ]+)`?.*/\1/p' <<< "$target_line")"
  if [[ -n "$target" && "$target" != "MISSING" && "$target" != "$base" ]]; then
    base_count=$((base_count + 1))
    printf '#%s %s\n  base: %s\n  contract target: %s\n  issue: #%s\n  %s\n' \
      "$pr" "$title" "$base" "$target" "$issue" "$(jq -r '.html_url' <<< "$pr_json")"
  fi
done < <(jq -c '.[]' <<< "$prs_json")
if [[ "$base_count" -eq 0 ]]; then
  printf 'none\n'
fi
